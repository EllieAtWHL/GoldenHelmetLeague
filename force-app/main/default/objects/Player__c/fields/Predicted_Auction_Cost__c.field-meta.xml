<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Predicted_Auction_Cost__c</fullName>
    <label>Predicted Auction Cost</label>
    <description
  >MFL_AAV__c scaled to this league&apos;s per-team auction budget (Draft_Settings__c.Auction_Budget__c). Always live - recalculates automatically if either input changes, no resync required.</description>
    <formula
  >IF(OR(ISBLANK(MFL_AAV__c), ISBLANK($Setup.Draft_Settings__c.Auction_Budget__c)), 0, MFL_AAV__c / 1000 * $Setup.Draft_Settings__c.Auction_Budget__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>16</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
